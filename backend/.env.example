# Google Gemini API configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# The deployed frontend URL (no trailing slash). Local Vite origins are always allowed.
FRONTEND_ORIGIN=https://your-frontend.example.com
# Optional comma-separated alternative to FRONTEND_ORIGIN.
# ALLOWED_ORIGINS=https://your-frontend.example.com,https://staging.example.com
